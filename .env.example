# Sadece backend ortamında kullanın. Unity istemcisine anahtar gömmeyin.
OPENAI_API_KEY=
OPENAI_MODEL=
HOLOASSIST_DATA_DIR=./data

# PostgreSQL container development settings (never commit real .env)
HOLOASSIST_APPROVAL_BACKEND=sqlite
HOLOASSIST_POSTGRES_HOST=127.0.0.1
HOLOASSIST_POSTGRES_PORT=5433
HOLOASSIST_POSTGRES_DATABASE=holoassist
HOLOASSIST_POSTGRES_USER=holoassist
HOLOASSIST_POSTGRES_PASSWORD=
# HOLOASSIST_REVIEWERS remains empty unless explicitly configured for the demo.
# Local development HTTP identities only; never embed these credentials in Unity.
HOLOASSIST_API_OPERATOR_TOKEN=
HOLOASSIST_API_REVIEWER_TOKEN=
