.workstation-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

/* --- Top Telemetry Bar --- */
.top-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(7, 19, 26, 0.98);
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 189, 248, 0.22);
}

.top-left-group {
    flex-direction: row;
    align-items: center;
}

.brand-mark {
    background-color: rgb(13, 148, 136);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 12px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    margin-right: 8px;
}

.brand-title {
    color: rgb(241, 248, 252);
    -unity-font-style: bold;
    font-size: 13px;
    margin-right: 6px;
}

.brand-sub {
    color: rgb(110, 231, 183);
    -unity-font-style: bold;
    font-size: 11px;
    margin-right: 12px;
}

.gov-pill {
    background-color: rgba(180, 83, 9, 0.28);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(251, 191, 36, 0.45);
    border-bottom-color: rgba(251, 191, 36, 0.45);
    border-left-color: rgba(251, 191, 36, 0.45);
    border-right-color: rgba(251, 191, 36, 0.45);
    color: rgb(253, 224, 71);
    -unity-font-style: bold;
    font-size: 10px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.top-right-group {
    flex-direction: row;
    align-items: center;
}

.health-pill {
    font-size: 11px;
    color: rgb(203, 224, 235);
    background-color: rgba(16, 38, 52, 0.92);
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(71, 120, 148, 0.35);
    border-bottom-color: rgba(71, 120, 148, 0.35);
    border-left-color: rgba(71, 120, 148, 0.35);
    border-right-color: rgba(71, 120, 148, 0.35);
    margin-right: 8px;
}

.health-pill-online {
    border-left-width: 3px;
    border-left-color: rgb(52, 211, 153);
}

.health-pill-offline {
    border-left-width: 3px;
    border-left-color: rgb(248, 113, 113);
}

.top-btn {
    height: 26px;
    padding-left: 9px;
    padding-right: 9px;
    margin-left: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(219, 234, 242);
    background-color: rgb(22, 48, 64);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(94, 156, 188, 0.35);
    border-bottom-color: rgba(94, 156, 188, 0.35);
    border-left-color: rgba(94, 156, 188, 0.35);
    border-right-color: rgba(94, 156, 188, 0.35);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.top-btn:hover {
    background-color: rgb(30, 66, 86);
}

.top-btn:active {
    background-color: rgb(16, 118, 110);
    color: rgb(255, 255, 255);
}

.top-btn.top-btn-active,
.top-btn.top-btn-active:hover,
.top-btn.top-btn-active:focus {
    background-color: rgb(13, 148, 136);
    color: rgb(255, 255, 255);
    border-top-color: rgb(52, 211, 153);
    border-bottom-color: rgb(52, 211, 153);
    border-left-color: rgb(52, 211, 153);
    border-right-color: rgb(52, 211, 153);
}

.top-btn-web {
    background-color: rgb(20, 83, 136);
    color: rgb(240, 249, 255);
}

.top-btn-web:hover {
    background-color: rgb(28, 104, 168);
}

/* --- Main 3-Column Body --- */
.workspace-body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
    width: 100%;
    overflow: hidden;
}

.left-dock {
    width: 24.5%;
    min-width: 255px;
    max-width: 340px;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgba(10, 25, 35, 0.97);
    border-right-width: 1px;
    border-right-color: rgba(56, 189, 248, 0.18);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.center-stage {
    flex-grow: 1;
    min-width: 220px;
    min-height: 0;
    background-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}

.right-dock {
    width: 34.5%;
    min-width: 300px;
    max-width: 465px;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgba(10, 25, 35, 0.97);
    border-left-width: 1px;
    border-left-color: rgba(56, 189, 248, 0.18);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

/* --- Section Typography --- */
.section-eyebrow {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(94, 234, 212);
    margin-bottom: 4px;
}

.endpoint-tag {
    font-size: 10px;
    color: rgb(125, 211, 252);
    margin-bottom: 8px;
}

.muted-note {
    font-size: 11px;
    color: rgb(156, 184, 201);
    white-space: normal;
    margin-bottom: 6px;
}

/* --- Module Segmented Tabs --- */
.module-tabs {
    flex-direction: row;
    margin-bottom: 12px;
    background-color: rgb(7, 18, 25);
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(71, 120, 148, 0.30);
    border-bottom-color: rgba(71, 120, 148, 0.30);
    border-left-color: rgba(71, 120, 148, 0.30);
    border-right-color: rgba(71, 120, 148, 0.30);
}

.tab-btn {
    flex-grow: 1;
    flex-basis: 0;
    height: 28px;
    padding-left: 3px;
    padding-right: 3px;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 1px;
    margin-right: 1px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(168, 196, 212);
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.tab-btn:hover {
    background-color: rgba(30, 64, 84, 0.55);
    color: rgb(235, 246, 252);
}

.tab-btn:active {
    background-color: rgb(15, 118, 110);
    color: rgb(255, 255, 255);
}

.tab-btn.tab-btn-active,
.tab-btn.tab-btn-active:hover,
.tab-btn.tab-btn-active:focus {
    background-color: rgb(13, 148, 136);
    color: rgb(255, 255, 255);
}

/* --- Scenario / Fixture Pick Cards --- */
.pick-btn {
    width: 100%;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    -unity-text-align: upper-left;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 6px;
    background-color: rgb(16, 38, 52);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-left-width: 3px;
    border-top-color: rgba(71, 120, 148, 0.30);
    border-bottom-color: rgba(71, 120, 148, 0.30);
    border-right-color: rgba(71, 120, 148, 0.30);
    border-left-color: rgba(71, 120, 148, 0.45);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.pick-btn:hover {
    background-color: rgb(22, 52, 70);
}

.pick-btn:active {
    background-color: rgba(13, 148, 136, 0.38);
    border-left-color: rgb(52, 211, 153);
}

.pick-btn.pick-btn-active,
.pick-btn.pick-btn-active:hover,
.pick-btn.pick-btn-active:focus {
    background-color: rgba(13, 148, 136, 0.24);
    border-left-color: rgb(52, 211, 153);
    border-top-color: rgba(52, 211, 153, 0.55);
    border-bottom-color: rgba(52, 211, 153, 0.55);
    border-right-color: rgba(52, 211, 153, 0.55);
}

.pick-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(238, 247, 252);
    white-space: normal;
    margin-bottom: 2px;
}

.pick-sub {
    font-size: 10px;
    color: rgb(142, 179, 199);
    white-space: normal;
}

.scene-ctrl-box {
    margin-top: 10px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(71, 120, 148, 0.25);
}

.secondary-btn {
    height: 28px;
    margin-bottom: 6px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(219, 234, 242);
    background-color: rgb(20, 45, 61);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(94, 156, 188, 0.35);
    border-bottom-color: rgba(94, 156, 188, 0.35);
    border-left-color: rgba(94, 156, 188, 0.35);
    border-right-color: rgba(94, 156, 188, 0.35);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.secondary-btn:hover {
    background-color: rgb(28, 62, 82);
}

.secondary-btn:active {
    background-color: rgb(15, 118, 110);
    color: rgb(255, 255, 255);
}

/* --- Center 3D Stage Overlays --- */
.stage-hud-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(7, 19, 26, 0.84);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(71, 120, 148, 0.35);
    border-bottom-color: rgba(71, 120, 148, 0.35);
    border-left-color: rgba(71, 120, 148, 0.35);
    border-right-color: rgba(71, 120, 148, 0.35);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.stage-hud-caption {
    font-size: 11px;
    color: rgb(191, 219, 235);
}

.stage-tracking-pill {
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.tracking-pill-ok {
    background-color: rgba(16, 185, 129, 0.22);
    color: rgb(110, 231, 183);
}

.tracking-pill-warn {
    background-color: rgba(245, 158, 11, 0.25);
    color: rgb(253, 224, 71);
}

.tracking-pill-muted {
    background-color: rgba(148, 163, 184, 0.20);
    color: rgb(203, 213, 225);
}

.spatial-callout {
    position: absolute;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(8, 25, 35, 0.95);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.spatial-callout-ok {
    border-top-color: rgb(52, 211, 153);
    border-bottom-color: rgb(52, 211, 153);
    border-left-color: rgb(52, 211, 153);
    border-right-color: rgb(52, 211, 153);
}

.spatial-callout-warn {
    border-top-color: rgb(245, 158, 11);
    border-bottom-color: rgb(245, 158, 11);
    border-left-color: rgb(245, 158, 11);
    border-right-color: rgb(245, 158, 11);
}

.spatial-callout-text {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(241, 249, 254);
}

.stage-bottom-notice {
    position: absolute;
    bottom: 54px;
    left: 14px;
    right: 14px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 6px;
    padding-bottom: 6px;
    background-color: rgba(28, 20, 12, 0.92);
    border-left-width: 3px;
    border-left-color: rgb(245, 158, 11);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.stage-quick-bar {
    position: absolute;
    bottom: 10px;
    left: 12px;
    right: 12px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(7, 19, 26, 0.90);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(56, 189, 248, 0.28);
    border-bottom-color: rgba(56, 189, 248, 0.28);
    border-left-color: rgba(56, 189, 248, 0.28);
    border-right-color: rgba(56, 189, 248, 0.28);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.stage-quick-btn {
    height: 26px;
    padding-left: 9px;
    padding-right: 9px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 1px;
    margin-bottom: 1px;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(224, 242, 254);
    background-color: rgb(18, 43, 58);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(94, 156, 188, 0.38);
    border-bottom-color: rgba(94, 156, 188, 0.38);
    border-left-color: rgba(94, 156, 188, 0.38);
    border-right-color: rgba(94, 156, 188, 0.38);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.stage-quick-btn:hover {
    background-color: rgb(28, 64, 86);
    border-top-color: rgb(56, 189, 248);
    border-bottom-color: rgb(56, 189, 248);
    border-left-color: rgb(56, 189, 248);
    border-right-color: rgb(56, 189, 248);
}

.stage-quick-btn:active {
    background-color: rgb(13, 148, 136);
    color: rgb(255, 255, 255);
}

.stage-bottom-notice-text {
    font-size: 11px;
    color: rgb(253, 224, 71);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* --- Right Inspector Cards & Banners --- */
.inspector-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.http-badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.http-badge-ok {
    background-color: rgba(16, 185, 129, 0.20);
    color: rgb(110, 231, 183);
}

.http-badge-err {
    background-color: rgba(239, 68, 68, 0.22);
    color: rgb(252, 165, 165);
}

.verdict-banner {
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 10px;
    border-left-width: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.verdict-ok {
    background-color: rgba(6, 78, 59, 0.55);
    border-left-color: rgb(52, 211, 153);
}

.verdict-warn {
    background-color: rgba(120, 53, 15, 0.52);
    border-left-color: rgb(245, 158, 11);
}

.verdict-blocked {
    background-color: rgba(127, 29, 29, 0.52);
    border-left-color: rgb(248, 113, 113);
}

.verdict-neutral {
    background-color: rgba(16, 38, 52, 0.85);
    border-left-color: rgb(94, 156, 188);
}

.verdict-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(248, 252, 255);
    white-space: normal;
    margin-bottom: 3px;
}

.verdict-body {
    font-size: 11px;
    color: rgb(208, 226, 237);
    white-space: normal;
}

.card-box {
    background-color: rgb(15, 36, 49);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(71, 120, 148, 0.32);
    border-bottom-color: rgba(71, 120, 148, 0.32);
    border-left-color: rgba(71, 120, 148, 0.32);
    border-right-color: rgba(71, 120, 148, 0.32);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-bottom: 8px;
}

.quote-allowed {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(236, 253, 245);
    white-space: normal;
}

.quote-redacted {
    font-size: 11px;
    color: rgb(253, 224, 71);
    white-space: normal;
}

.kv-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 98, 122, 0.22);
}

.kv-key {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(142, 179, 199);
    width: 126px;
    flex-shrink: 0;
}

.kv-val {
    font-size: 10px;
    color: rgb(226, 241, 248);
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-right;
}

.kv-val-warn {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(253, 224, 71);
    flex-grow: 1;
    white-space: normal;
    -unity-text-align: middle-right;
}

.code-panel {
    background-color: rgb(6, 16, 23);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(56, 189, 248, 0.24);
    border-bottom-color: rgba(56, 189, 248, 0.24);
    border-left-color: rgba(56, 189, 248, 0.24);
    border-right-color: rgba(56, 189, 248, 0.24);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 7px;
    padding-bottom: 7px;
    margin-bottom: 8px;
}

.code-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(94, 234, 212);
    margin-bottom: 3px;
}

.code-text {
    font-size: 10px;
    color: rgb(196, 228, 245);
    white-space: normal;
}

/* --- Sensor Chart, KPI Grid & Sample Table --- */
.chart-image {
    width: 100%;
    height: 136px;
    margin-bottom: 6px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.kpi-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-bottom: 6px;
}

.kpi-card {
    width: 48.5%;
    background-color: rgb(12, 30, 42);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(71, 120, 148, 0.28);
    border-bottom-color: rgba(71, 120, 148, 0.28);
    border-left-color: rgba(71, 120, 148, 0.28);
    border-right-color: rgba(71, 120, 148, 0.28);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 6px;
}

.kpi-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(138, 174, 194);
}

.kpi-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(240, 249, 255);
}

.sample-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 3px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(56, 98, 122, 0.20);
}

.sample-cell {
    font-size: 10px;
    color: rgb(206, 225, 236);
}

.sample-outlier {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(251, 191, 36);
}

/* --- Diagnostic Evidence Cards --- */
.ev-support-box {
    background-color: rgba(6, 78, 59, 0.35);
    border-left-width: 3px;
    border-left-color: rgb(52, 211, 153);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-top: 5px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ev-contradict-box {
    background-color: rgba(120, 53, 15, 0.35);
    border-left-width: 3px;
    border-left-color: rgb(245, 158, 11);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-top: 5px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* --- Export Footer Card --- */
.export-pills-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 8px;
}

.export-pill {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(167, 243, 208);
    background-color: rgba(13, 148, 136, 0.22);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 2px;
    padding-bottom: 2px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.primary-export-btn {
    height: 30px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(13, 148, 136);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.primary-export-btn:hover {
    background-color: rgb(15, 118, 110);
}

.primary-export-btn:active {
    background-color: rgb(17, 94, 89);
}

